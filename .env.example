# Filterly configuration. Copy to .env for local use, or set these as
# service variables on Railway. Every value is optional and has a default.

# --- Database ---------------------------------------------------------------
# Set DATABASE_URL to run on Postgres (Neon, Railway Postgres, RDS, …). When it
# is set, FILTERLY_DB is ignored and the schema is created automatically on
# first boot. Leave it unset to use a local SQLite file (FILTERLY_DB).
#
# Neon: create a project at https://neon.tech, then copy the connection string.
# The pooled endpoint (host contains "-pooler") is recommended for a persistent
# server. sslmode=require is required and handled automatically.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/filterly?sslmode=require

# SQLite file path, used only when DATABASE_URL is unset.
# FILTERLY_DB=filterly.db

# Postgres tuning (optional):
# PGPOOL_MAX=10          # max pooled connections
# PGSSL_STRICT=1         # verify the TLS chain strictly (default: relaxed for managed providers)

# --- HTTP server ------------------------------------------------------------
# PORT is provided by Railway automatically; set it only for local runs.
# PORT=4117
# HOST=0.0.0.0
# FILTERLY_NAME=Filterly

# --- Identities (for probe fleet / agents) ----------------------------------
# FILTERLY_KEY=.filterly/identity.json
# FILTERLY_PROBE_KEY=.filterly/probe-key.json
# FILTERLY_PROBE_LABEL=filterly probe fleet
